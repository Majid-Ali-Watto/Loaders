{
	"name": "circle-loader",
	"version": "1.1.0",
	"description": "50 circular loading spinners with one small API. Show a loader over the page or inside an element, with colors, sizes, text, backgrounds and presets. No dependencies, tree-shakable, SSR-safe, TypeScript types. Works with React, Vue, Angular, Svelte, Next.js, Nuxt and plain JavaScript.",
	"main": "dist/bundle.js",
	"module": "dist/bundle.mjs",
	"types": "types/index.d.ts",
	"unpkg": "dist/circle-loader.min.js",
	"jsdelivr": "dist/circle-loader.min.js",
	"exports": {
		".": {
			"import": {
				"types": "./types/index.d.mts",
				"default": "./dist/bundle.mjs"
			},
			"require": {
				"types": "./types/index.d.ts",
				"default": "./dist/bundle.js"
			}
		},
		"./core": {
			"import": {
				"types": "./types/core.d.mts",
				"default": "./dist/core.mjs"
			},
			"require": {
				"types": "./types/core.d.ts",
				"default": "./dist/core.js"
			}
		},
		"./variants": {
			"import": {
				"types": "./types/variants.d.mts",
				"default": "./dist/variants.mjs"
			},
			"require": {
				"types": "./types/variants.d.ts",
				"default": "./dist/variants.js"
			}
		},
		"./element": {
			"import": {
				"types": "./types/element.d.mts",
				"default": "./dist/element.mjs"
			},
			"require": {
				"types": "./types/element.d.ts",
				"default": "./dist/element.js"
			}
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"sideEffects": [
		"./dist/bundle.js",
		"./dist/bundle.mjs",
		"./dist/circle-loader.min.js",
		"./dist/circle-loader.element.min.js",
		"./dist/circle-loader.core.min.js",
		"./dist/variants/*.min.js",
		"./dist/element.js",
		"./dist/element.mjs"
	],
	"files": [
		"dist",
		"types",
		"README.md",
		"package.json"
	],
	"scripts": {
		"build": "node scripts/clean.js && rollup -c rollup.config.mjs && node scripts/copy-types.js",
		"test": "npm run build && node --test test/*.test.js",
		"prepublishOnly": "npm test",
		"demo": "npm run build && node scripts/demo.js",
		"docs:svgs": "npm run build && node scripts/variant-svgs.js"
	},
	"keywords": [
		"loader",
		"loading spinner",
		"spinner",
		"loading overlay",
		"loading screen",
		"UI",
		"circle-loader",
		"vanilla js",
		"react",
		"vue",
		"angular",
		"svelte",
		"nextjs",
		"nuxt",
		"css spinner",
		"loading indicator",
		"typescript",
		"framework agnostic",
		"tree-shaking"
	],
	"author": {
		"name": "Majid Ali",
		"url": "https://majidev.netlify.app"
	},
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Majid-Ali-Watto/Loaders.git"
	},
	"homepage": "https://github.com/Majid-Ali-Watto/Loaders#readme",
	"bugs": {
		"url": "https://github.com/Majid-Ali-Watto/Loaders/issues"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.2",
		"jsdom": "^24.1.3",
		"rollup": "^4.68.8",
		"rollup-plugin-postcss": "^4.0.2"
	}
}
